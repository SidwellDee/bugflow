olor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="340" height="211" as="geometry"/></mxCell><mxCell id="account-attributes" value="+ userId: Integer {PK, FK}&#xa;+ email: Text {unique}&#xa;+ passwordHash: Text [0..1]&#xa;+ googleSub: Text [0..1] {unique}&#xa;+ verified: Boolean&#xa;+ notifications: Boolean&#xa;+ createdAt: UTC timestamp" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="account"><mxGeometry x="0" y="46" width="340" height="165" as="geometry"/></mxCell><mxCell id="session" value="«entity»&#xa;Session" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#e9f1fb;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="170" width="320" height="127" as="geometry"/></mxCell><mxCell id="session-attributes" value="+ hash: SHA256 {PK}&#xa;+ userId: Integer {FK}&#xa;+ expires: Epoch milliseconds" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="session"><mxGeometry x="0" y="46" width="320" height="81" as="geometry"/></mxCell><mxCell id="verify" value="«entity»&#xa;VerificationToken" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#e9f1fb;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="460" width="320" height="127" as="geometry"/></mxCell><mxCell id="verify-attributes" value="+ hash: SHA256 {PK}&#xa;+ userId: Integer {FK}&#xa;+ expires: Epoch milliseconds" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="verify"><mxGeometry x="0" y="46" width="320" height="81" as="geometry"/></mxCell><mxCell id="admin" value="«entity»&#xa;SystemAdministrator" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#eeeafa;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="300" height="127" as="geometry"/></mxCell><mxCell id="admin-attributes" value="+ userId: Integer {PK, FK}&#xa;{role must remain Manager}&#xa;{access to every project}" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="admin"><mxGeometry x="0" y="46" width="300" height="81" as="geometry"/></mxCell><mxCell id="flow" value="«entity»&#xa;OAuthFlow" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#e9f1fb;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="510" width="340" height="190" as="geometry"/></mxCell><mxCell id="flow-attributes" value="+ hash: SHA256 state {PK}&#xa;+ purpose: login | gmail&#xa;+ userId: Integer [0..1]&#xa;+ verifier: PKCE verifier&#xa;+ nonce: Text&#xa;+ expires: Epoch milliseconds" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="flow"><mxGeometry x="0" y="46" width="340" height="144" as="geometry"/></mxCell><mxCell id="gmail" value="«entity»&#xa;GmailConnection" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff1df;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="300" height="127" as="geometry"/></mxCell><mxCell id="gmail-attributes" value="+ id: Integer {singleton = 1}&#xa;+ email: Text&#xa;+ refreshToken: Encrypted text" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="gmail"><mxGeometry x="0" y="46" width="300" height="81" as="geometry"/></mxCell><mxCell id="outbox" value="«entity»&#xa;MailOutboxMessage" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff1df;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="810" width="320" height="232" as="geometry"/></mxCell><mxCell id="outbox-attributes" value="+ id: Integer&#xa;+ recipient, subject: Text&#xa;+ body: Encrypted text&#xa;+ status: pending | sent | failed&#xa;+ attempts: Integer&#xa;+ nextAttempt: Epoch milliseconds&#xa;+ createdAt: UTC timestamp&#xa;+ sentAt: UTC timestamp [0..1]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="outbox"><mxGeometry x="0" y="46" width="320" height="186" as="geometry"/></mxCell><mxCell id="note16" value="IDENTITY AND DELIVERY NOTES&#xa;Sample team members may have no Account.&#xa;Passwords and bearer tokens are not stored&#xa;as plaintext password/session values.&#xa;OAuthFlow.userId is set for Gmail setup;&#xa;Google sign-in begins without a local user.&#xa;&#xa;SMTP email and App Password are server&#xa;configuration, not GmailConnection rows.&#xa;Outbox recipients are email addresses,&#xa;not foreign keys to user accounts." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff9eb;shape=note;size=16;align=left;verticalAlign=top;spacing=12;strokeColor=#d5bb7b;" vertex="1" parent="1"><mxGeometry x="540" y="840" width="380" height="260" as="geometry"/></mxCell><mxCell id="note22" value="No association between mail records is&#xa;implied: the sender connection is global.&#xa;The mail worker chooses the configured&#xa;SMTP sender or OAuth sender at runtime." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff9eb;shape=note;size=16;align=left;verticalAlign=top;spacing=12;strokeColor=#d5bb7b;" vertex="1" parent="1"><mxGeometry x="60" y="715" width="360" height="125" as="geometry"/></mxCell><mxCell id="edge17-mult-0" value="1" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="359" y="213.5" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge17-mult-1" value="0..1" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="513" y="213.3" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge18-mult-0" value="1" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="186" y="127" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge18-mult-1" value="0..*" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1216" y="127" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge19-mult-0" value="1" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="344" y="277" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge19-mult-1" value="0..*" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1033" y="503.5" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge20-mult-0" value="1" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="186" y="300" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge20-mult-1" value="0..1" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="186" y="467" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge21-mult-0" value="0..1" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="261" y="300" width="48" height="18" as="geometry"/></mxCell><mxCell id="edge21-mult-1" value="0..*" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364b;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="706" y="467" width="48" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="BugFlow_Class_Diagram-3" name="Class diagram — application service design"><mxGraphModel dx="1480" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="edge25" value="delegates identity" style="edgeStyle=none;noEdgeStyle=1;orthogonal=1;rounded=0;html=0;endArrow=open;endFill=0;strokeColor=#9276b3;strokeWidth=1.4;dashed=1;fontFamily=Arial;fontSize=12;fontColor=#4d5f74;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="accounts"><mxGeometry relative="1" as="geometry"><mxPoint x="-86.5" y="-20" as="offset"/><Array as="points"><mxPoint x="622" y="405"/><mxPoint x="240" y="405"/></Array></mxGeometry></mxCell><mxCell id="edge26" value="delegates scope" style="edgeStyle=none;noEdgeStyle=1;orthogonal=1;rounded=0;html=0;endArrow=open;endFill=0;strokeColor=#9276b3;strokeWidth=1.4;dashed=1;fontFamily=Arial;fontSize=12;fontColor=#4d5f74;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="projects"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="5.5" as="offset"/></mxGeometry></mxCell><mxCell id="edge27" value="queues / starts delivery" style="edgeStyle=none;noEdgeStyle=1;orthogonal=1;rounded=0;html=0;endArrow=open;endFill=0;strokeColor=#9276b3;strokeWidth=1.4;dashed=1;fontFamily=Arial;fontSize=12;fontColor=#4d5f74;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="mail"><mxGeometry relative="1" as="geometry"><mxPoint x="156.5" y="-20" as="offset"/><Array as="points"><mxPoint x="838" y="405"/><mxPoint x="1220" y="405"/></Array></mxGeometry></mxCell><mxCell id="edge28" value="hashes / generates tokens" style="edgeStyle=none;noEdgeStyle=1;orthogonal=1;rounded=0;html=0;endArrow=open;endFill=0;strokeColor=#9276b3;strokeWidth=1.4;dashed=1;fontFamily=Arial;fontSize=12;fontColor=#4d5f74;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="accounts" target="security"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="28" as="offset"/></mxGeometry></mxCell><mxCell id="edge29" value="validates before persistence" style="edgeStyle=none;noEdgeStyle=1;orthogonal=1;rounded=0;html=0;endArrow=open;endFill=0;strokeColor=#9276b3;strokeWidth=1.4;dashed=1;fontFamily=Arial;fontSize=12;fontColor=#4d5f74;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="projects" target="store"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="28" as="offset"/></mxGeometry></mxCell><mxCell id="edge30" value="encrypts / decrypts" style="edgeStyle=none;noEdgeStyle=1;orthogonal=1;rounded=0;html=0;endArrow=open;endFill=0;strokeColor=#9276b3;strokeWidth=1.4;dashed=1;fontFamily=Arial;fontSize=12;fontColor=#4d5f74;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail" target="security"><mxGeometry relative="1" as="geometry"><mxPoint x="-215.89999999999998" y="-15" as="offset"/><Array as="points"><mxPoint x="970" y="644"/><mxPoint x="970" y="668"/><mxPoint x="970" y="815"/><mxPoint x="470" y="815"/><mxPoint x="470" y="934"/><mxPoint x="470" y="933.8"/></Array></mxGeometry></mxCell><mxCell id="text23" value="Class diagram — application service design" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=30;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#ffffff;shape=rectangle;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1400" height="42" as="geometry"/></mxCell><mxCell id="text24" value="Conceptual service classes represent JavaScript factory return objects and pure utilities, not ES class declarations." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#627389;strokeColor=#718299;strokeWidth=1.2;fillColor=#ffffff;shape=rectangle;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1400" height="40" as="geometry"/></mxCell><mxCell id="app" value="«service facade»&#xa;ApplicationService" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#eeeafa;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="360" height="169" as="geometry"/></mxCell><mxCell id="app-attributes" value="+ handle(request, response, url, send)&#xa;+ close()&#xa;- accounts, projects, gmail&#xa;- current(request), authorize(...)&#xa;- verifyMail(user), deliver()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="app"><mxGeometry x="0" y="46" width="360" height="123" as="geometry"/></mxCell><mxCell id="accounts" value="«factory service»&#xa;AccountsService" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#e9f1fb;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="360" height="274" as="geometry"/></mxCell><mxCell id="accounts-attributes" value="- db: SQLite connection&#xa;+ register(data), login(data)&#xa;+ google(claims), profile(userId)&#xa;+ session(userId), current(token)&#xa;+ logout(token)&#xa;+ verification(userId), verify(token)&#xa;+ preference(userId, enabled)&#xa;+ list(), role(userId, role, actor)&#xa;+ flow(purpose, userId)&#xa;+ consumeFlow(state, cookie)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="accounts"><mxGeometry x="0" y="46" width="360" height="228" as="geometry"/></mxCell><mxCell id="projects" value="«factory service»&#xa;ProjectsService" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#eeeafa;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="470" width="360" height="274" as="geometry"/></mxCell><mxCell id="projects-attributes" value="- store: StoreService&#xa;+ data(user)&#xa;+ create(data, user)&#xa;+ updateMembers(data, user)&#xa;+ module(data, user)&#xa;+ validateBug(data, user)&#xa;+ requireMember(projectId, user)&#xa;+ requireManager(projectId, user)&#xa;+ export(user, projectId)&#xa;- syncAdministrators()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="projects"><mxGeometry x="0" y="46" width="360" height="228" as="geometry"/></mxCell><mxCell id="mail" value="«factory service»&#xa;GmailService" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff1df;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="360" height="232" as="geometry"/></mxCell><mxCell id="mail-attributes" value="- db, config, vault&#xa;- fetcher, smtpTransport&#xa;+ status()&#xa;+ connect(email, refreshToken)&#xa;+ disconnect()&#xa;+ queue(recipient, subject, body)&#xa;+ flush()&#xa;- busy, lastError" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#33465b;spacing=10;overflow=hidden;" vertex="1" parent="mail"><mxGeometry x="0" y="46" width="360" height="186" as="geometry"/></mxCell><mxCell id="security" value="«utility»&#xa;Security" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#f2f5f9;shape=swimlane;startSize=46;rounded=0;align=center;verticalAlign=middle;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="360" height="169" as="geometry"/></mxCell><mxCell id="security-attributes" value="+ email(value)&#xa;+ hashPassword(password)&#xa;+ checkPassword(password, hash)&#xa;+ token()