eometry x="545" y="855" width="180" height="90" as="geometry"/></mxCell><mxCell id="smtp-send" value="Send using Nodemailer&#xa;smtp.gmail.com:465 with TLS" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff1df;shape=rectangle;rounded=1;arcSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="925" y="835" width="290" height="90" as="geometry"/></mxCell><mxCell id="oauth-send" value="Refresh OAuth access token;&#xa;send MIME via Gmail API&#xa;users.messages.send" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff1df;shape=rectangle;rounded=1;arcSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="925" y="1050" width="290" height="110" as="geometry"/></mxCell><mxCell id="success" value="Send succeeded?" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fff1df;shape=rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1200" width="170" height="90" as="geometry"/></mxCell><mxCell id="sent" value="Mark message sent;&#xa;record sentAt" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#e8f4ee;shape=rectangle;rounded=1;arcSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="1375" width="280" height="70" as="geometry"/></mxCell><mxCell id="retry" value="On send failure: attempts + 1;&#xa;retry after at least 60 seconds;&#xa;mark failed after five attempts" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24364b;strokeColor=#718299;strokeWidth=1.2;fillColor=#fbeaec;shape=rectangle;rounded=1;arcSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="490" y="1375" width="29